<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>StackletConfig</class>
 <widget class="QWidget" name="StackletConfig">
  <layout class="QVBoxLayout" name="page">
   <item>
    <widget class="QTabWidget" name="tabs">
     <property name="currentIndex"><number>0</number></property>
     <widget class="QWidget" name="tabLayout">
      <attribute name="title"><string>Layout</string></attribute>
      <layout class="QVBoxLayout" name="tabLayoutBox">

   <item>
    <widget class="QLabel" name="styleGroupHeading">
     <property name="textFormat"><enum>Qt::RichText</enum></property>
     <property name="text"><string>&lt;b&gt;&lt;span style=&quot;font-size:large&quot;&gt;Layout style&lt;/span&gt;&lt;/b&gt;</string></property>
     <property name="accessibleName"><string>Layout style</string></property>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="styleGroup">
     <layout class="QGridLayout" name="styleGrid">
      <item row="0" column="0">
       <widget class="QLabel" name="previewTile">
        <property name="alignment"><set>Qt::AlignCenter</set></property>
        <property name="accessibleDescription"><string>Preview: one large window on the left, the others stacked on the right</string></property>
        <property name="text"><string>&lt;img src=&quot;data:image/svg+xml;base64,&quot; width=&quot;128&quot; height=&quot;80&quot;&gt;</string></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QLabel" name="previewSpiral">
        <property name="alignment"><set>Qt::AlignCenter</set></property>
        <property name="accessibleDescription"><string>Preview: a large window on the left, the others spiralling into the right half</string></property>
        <property name="text"><string>&lt;img src=&quot;data:image/svg+xml;base64,&quot; width=&quot;128&quot; height=&quot;80&quot;&gt;</string></property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="previewMonocle">
        <property name="alignment"><set>Qt::AlignCenter</set></property>
        <property name="accessibleDescription"><string>Preview: one window fills the screen, the others are stacked behind it</string></property>
        <property name="text"><string>&lt;img src=&quot;data:image/svg+xml;base64,&quot; width=&quot;128&quot; height=&quot;80&quot;&gt;</string></property>
       </widget>
      </item>
      <item row="0" column="3">
       <widget class="QLabel" name="previewCentered">
        <property name="alignment"><set>Qt::AlignCenter</set></property>
        <property name="accessibleDescription"><string>Preview: one large window in the middle, the others in narrow columns on both sides</string></property>
        <property name="text"><string>&lt;img src=&quot;data:image/svg+xml;base64,&quot; width=&quot;128&quot; height=&quot;80&quot;&gt;</string></property>
       </widget>
      </item>
      <item row="0" column="4">
       <widget class="QLabel" name="previewDwindle">
        <property name="alignment"><set>Qt::AlignCenter</set></property>
        <property name="accessibleDescription"><string>Preview: each window split in two where a new one opened, side by side or top and bottom</string></property>
        <property name="text"><string>&lt;img src=&quot;data:image/svg+xml;base64,&quot; width=&quot;128&quot; height=&quot;80&quot;&gt;</string></property>
       </widget>
      </item>
      <item row="1" column="0" alignment="Qt::AlignHCenter">
       <widget class="QRadioButton" name="kcfg_layoutTile">
        <property name="text"><string>Master and stack</string></property>
        <property name="toolTip"><string>One main window, the rest stacked beside it.</string></property>
       </widget>
      </item>
      <item row="1" column="1" alignment="Qt::AlignHCenter">
       <widget class="QRadioButton" name="kcfg_layoutSpiral">
        <property name="text"><string>Spiral</string></property>
        <property name="toolTip"><string>Each new window takes half of the space left, turning clockwise.</string></property>
       </widget>
      </item>
      <item row="1" column="2" alignment="Qt::AlignHCenter">
       <widget class="QRadioButton" name="kcfg_layoutMonocle">
        <property name="text"><string>Monocle</string></property>
        <property name="toolTip"><string>One window fills the screen; cycle through the others.</string></property>
       </widget>
      </item>
      <item row="1" column="3" alignment="Qt::AlignHCenter">
       <widget class="QRadioButton" name="kcfg_layoutCentered">
        <property name="text"><string>Centered</string></property>
        <property name="toolTip"><string>The main window in the middle, the others in columns on both sides.</string></property>
       </widget>
      </item>
      <item row="1" column="4" alignment="Qt::AlignHCenter">
       <widget class="QRadioButton" name="kcfg_layoutDwindle">
        <property name="text"><string>Dwindle</string></property>
        <property name="toolTip"><string>A new window splits the focused one, along its longer side. Meta+Alt+H / V pick the side, Meta+Alt+E flips a split.</string></property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="hintTile">
        <property name="alignment"><set>Qt::AlignHCenter|Qt::AlignTop</set></property>
        <property name="wordWrap"><bool>true</bool></property>
        <property name="minimumSize"><size><width>0</width><height>68</height></size></property>
        <property name="textFormat"><enum>Qt::RichText</enum></property>
        <property name="text"><string>&lt;small&gt;A main window and a stack. For 2 to 4 terminals.&lt;/small&gt;</string></property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QLabel" name="hintSpiral">
        <property name="alignment"><set>Qt::AlignHCenter|Qt::AlignTop</set></property>
        <property name="wordWrap"><bool>true</bool></property>
        <property name="minimumSize"><size><width>0</width><height>68</height></size></property>
        <property name="textFormat"><enum>Qt::RichText</enum></property>
        <property name="text"><string>&lt;small&gt;Many terminals on a big screen. Looks like master and stack until 4 windows.&lt;/small&gt;</string></property>
       </widget>
      </item>
      <item row="2" column="2">
       <widget class="QLabel" name="hintMonocle">
        <property name="alignment"><set>Qt::AlignHCenter|Qt::AlignTop</set></property>
        <property name="wordWrap"><bool>true</bool></property>
        <property name="minimumSize"><size><width>0</width><height>68</height></size></property>
        <property name="textFormat"><enum>Qt::RichText</enum></property>
        <property name="text"><string>&lt;small&gt;Small screens, or one job per desktop.&lt;/small&gt;</string></property>
       </widget>
      </item>
      <item row="2" column="3">
       <widget class="QLabel" name="hintCentered">
        <property name="alignment"><set>Qt::AlignHCenter|Qt::AlignTop</set></property>
        <property name="wordWrap"><bool>true</bool></property>
        <property name="minimumSize"><size><width>0</width><height>68</height></size></property>
        <property name="textFormat"><enum>Qt::RichText</enum></property>
        <property name="text"><string>&lt;small&gt;Wide screens: the window you work in stays in front of you.&lt;/small&gt;</string></property>
       </widget>
      </item>
      <item row="2" column="4">
       <widget class="QLabel" name="hintDwindle">
        <property name="alignment"><set>Qt::AlignHCenter|Qt::AlignTop</set></property>
        <property name="wordWrap"><bool>true</bool></property>
        <property name="minimumSize"><size><width>0</width><height>68</height></size></property>
        <property name="textFormat"><enum>Qt::RichText</enum></property>
        <property name="text"><string>&lt;small&gt;i3 and Hyprland habits: new windows open next to the one you work in.&lt;/small&gt;</string></property>
       </widget>
      </item>
      <item row="3" column="0" colspan="5">
       <layout class="QFormLayout" name="styleForm">
        <item row="0" column="0">
         <widget class="QLabel" name="desktopLayoutsLabel">
          <property name="text"><string>Per desk&amp;top:</string></property>
          <property name="buddy"><cstring>kcfg_desktopLayouts</cstring></property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QLineEdit" name="kcfg_desktopLayouts">
          <property name="placeholderText"><string>e.g. 1=master,2=monocle,3=centered</string></property>
         </widget>
        </item>
        <item row="1" column="0" colspan="2">
         <widget class="QLabel" name="styleHint">
          <property name="wordWrap"><bool>true</bool></property>
          <property name="textFormat"><enum>Qt::RichText</enum></property>
          <property name="text"><string>&lt;small&gt;Starting layout. To give a virtual desktop its own, write its number, = and a layout name (master, spiral, monocle, centered or dwindle), separated by commas. Meta+Shift+Space switches the layout on the current screen and desktop. The choice is usually kept after a restart (it is saved through Plasma&apos;s shell), until you change the layout this page gives that desktop.&lt;/small&gt;</string></property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>

   <item><spacer name="layoutGroupGap"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>0</width><height>14</height></size></property></spacer></item>
   <item>
    <widget class="QLabel" name="layoutGroupHeading">
     <property name="textFormat"><enum>Qt::RichText</enum></property>
     <property name="text"><string>&lt;b&gt;&lt;span style=&quot;font-size:large&quot;&gt;Sizes and gaps&lt;/span&gt;&lt;/b&gt;</string></property>
     <property name="accessibleName"><string>Sizes and gaps</string></property>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="layoutGroup">
     <layout class="QFormLayout" name="layoutForm">
      <item row="0" column="0">
       <widget class="QLabel" name="sideLabel">
        <property name="text"><string>Main window &amp;side:</string></property>
        <property name="buddy"><cstring>kcfg_mainSide</cstring></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="kcfg_mainSide">
        <item><property name="text"><string>Left</string></property></item>
        <item><property name="text"><string>Right</string></property></item>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="ratioLabel">
        <property name="text"><string>Main window &amp;width:</string></property>
        <property name="buddy"><cstring>kcfg_masterRatio</cstring></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="kcfg_masterRatio">
        <property name="toolTip"><string>How much of the screen width the main window gets: 0.55 = 55%, from 0.15 to 0.85. On a portrait screen this is its height.</string></property>
        <property name="minimum"><double>0.15</double></property>
        <property name="maximum"><double>0.85</double></property>
        <property name="singleStep"><double>0.05</double></property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="mainLabel">
        <property name="text"><string>Windows in the &amp;main column:</string></property>
        <property name="buddy"><cstring>kcfg_maxMain</cstring></property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QSpinBox" name="kcfg_maxMain">
        <property name="minimum"><number>1</number></property>
        <property name="maximum"><number>2</number></property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="gapLabel">
        <property name="text"><string>&amp;Gap:</string></property>
        <property name="buddy"><cstring>kcfg_gap</cstring></property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QSpinBox" name="kcfg_gap">
        <property name="toolTip"><string>Space between tiles and around the screen edge.</string></property>
        <property name="suffix"><string> px</string></property>
        <property name="minimum"><number>0</number></property>
        <property name="maximum"><number>64</number></property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QCheckBox" name="kcfg_smartGaps">
        <property name="text"><string>No gap around a single window or in monocle</string></property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="centerRatioLabel">
        <property name="text"><string>Ce&amp;ntred window width:</string></property>
        <property name="buddy"><cstring>kcfg_centerRatio</cstring></property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QDoubleSpinBox" name="kcfg_centerRatio">
        <property name="toolTip"><string>Centered layout: how much of the screen width the main window gets, 0.5 = 50% (from 0.15 to 0.85); on a portrait screen, its height. Not used while the stash is on: then the main window takes what the stash columns leave.</string></property>
        <property name="minimum"><double>0.15</double></property>
        <property name="maximum"><double>0.85</double></property>
        <property name="singleStep"><double>0.05</double></property>
       </widget>
      </item>
      <item row="6" column="1">
       <widget class="QCheckBox" name="kcfg_stash">
        <property name="text"><string>Centered: narrow side columns (stash)</string></property>
        <property name="toolTip"><string>The other windows stay small and live at the screen edges; the main window takes the rest. Spotlight (Meta+Alt+C) turns it on for one screen and desktop.</string></property>
       </widget>
      </item>
      <item row="7" column="0">
       <widget class="QLabel" name="stashWidthLabel">
        <property name="text"><string>S&amp;tash column width:</string></property>
        <property name="buddy"><cstring>kcfg_stashWidth</cstring></property>
       </widget>
      </item>
      <item row="7" column="1">
       <widget class="QDoubleSpinBox" name="kcfg_stashWidth">
        <property name="toolTip"><string>How much of the screen width each side column gets: 0.15 = 15%, from 0.05 to 0.3.</string></property>
        <property name="minimum"><double>0.05</double></property>
        <property name="maximum"><double>0.30</double></property>
        <property name="singleStep"><double>0.05</double></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <item><spacer name="spacerLayout"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Expanding</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>0</height></size></property></spacer></item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabApps">
      <attribute name="title"><string>Apps</string></attribute>
      <layout class="QVBoxLayout" name="tabAppsBox">
   <item>
    <widget class="QGroupBox" name="appsGroup">
     <property name="flat"><bool>true</bool></property>
     <layout class="QFormLayout" name="appsForm">
      <item row="0" column="0" colspan="2">
       <widget class="QCheckBox" name="kcfg_tileAll">
        <property name="text"><string>Tile all apps, not only the ones listed below</string></property>
        <property name="toolTip"><string>Off (the default): only the apps in "Tile these apps" tile, terminals to start with. On: every app tiles, except what the float options and "Never tile" below keep floating.</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="classesLabel">
        <property name="text"><string>&amp;Tile these apps:</string></property>
        <property name="buddy"><cstring>kcfg_tileClasses</cstring></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="kcfg_tileClasses">
        <property name="placeholderText"><string>e.g. kitty,org.kde.konsole</string></property>
        <property name="toolTip"><string>Only these apps are tiled; everything else floats. Not used while "Tile all apps" is ticked.</string></property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QCheckBox" name="kcfg_floatSystem">
        <property name="enabled"><bool>false</bool></property>
        <property name="text"><string>Float system apps and utilities</string></property>
        <property name="toolTip"><string>System Settings, file pickers and password prompts, password managers, calculators and screenshot tools, image viewers, and "Configure" dialogs stay floating. Meta+Alt+A tiles one of them anyway.</string></property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QCheckBox" name="kcfg_floatMedia">
        <property name="enabled"><bool>false</bool></property>
        <property name="text"><string>Float games and media players</string></property>
        <property name="toolTip"><string>Steam and its games, Lutris, Heroic, Bottles, Windows (.exe) apps, and video and music players stay floating. Meta+Alt+A tiles one of them anyway.</string></property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="floatClassesLabel">
        <property name="enabled"><bool>false</bool></property>
        <property name="text"><string>&amp;Never tile:</string></property>
        <property name="buddy"><cstring>kcfg_floatClasses</cstring></property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QLineEdit" name="kcfg_floatClasses">
        <property name="enabled"><bool>false</bool></property>
        <property name="placeholderText"><string>e.g. org.gimp.gimp,obs</string></property>
        <property name="toolTip"><string>With "Tile all apps" ticked, these apps stay floating. Dialogs and fixed-size windows always float.</string></property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="mainClassesLabel">
        <property name="text"><string>Always &amp;main:</string></property>
        <property name="buddy"><cstring>kcfg_mainClasses</cstring></property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QLineEdit" name="kcfg_mainClasses">
        <property name="placeholderText"><string>e.g. firefox,code</string></property>
        <property name="toolTip"><string>These apps always take the main slot; other windows stack beside them.</string></property>
       </widget>
      </item>
      <item row="6" column="1">
       <widget class="QLabel" name="classesHint">
        <property name="wordWrap"><bool>true</bool></property>
        <property name="textFormat"><enum>Qt::RichText</enum></property>
        <property name="text"><string>&lt;small&gt;Window classes, separated by commas. Press Meta+Alt+A on a window to add or remove its app.&lt;br&gt;&lt;br&gt;Not tiling? Dialogs (also modal ones without a parent), fixed-size windows, and windows that are minimized, fullscreen or on all desktops are left alone, and so are screens and desktops where tiling is turned off (Behaviour tab).&lt;/small&gt;</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <item><spacer name="spacerApps"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Expanding</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>0</height></size></property></spacer></item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabBehaviour">
      <attribute name="title"><string>Behaviour</string></attribute>
      <layout class="QVBoxLayout" name="tabBehaviourBox">
   <item>
    <widget class="QLabel" name="windowsGroupHeading">
     <property name="textFormat"><enum>Qt::RichText</enum></property>
     <property name="text"><string>&lt;b&gt;&lt;span style=&quot;font-size:large&quot;&gt;New and closed windows&lt;/span&gt;&lt;/b&gt;</string></property>
     <property name="accessibleName"><string>New and closed windows</string></property>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="windowsGroup">
     <layout class="QFormLayout" name="windowsForm">
      <item row="0" column="0">
       <widget class="QLabel" name="newLabel">
        <property name="text"><string>New windows &amp;go to:</string></property>
        <property name="buddy"><cstring>kcfg_newWindow</cstring></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="kcfg_newWindow">
        <item><property name="text"><string>Bottom of the stack</string></property></item>
        <item><property name="text"><string>Top of the stack</string></property></item>
        <item><property name="text"><string>Main column</string></property></item>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QCheckBox" name="kcfg_focusAfterClose">
        <property name="text"><string>After closing a window, focus the tile before it</string></property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QCheckBox" name="kcfg_dragFloats">
        <property name="text"><string>Dragging a window out of its tile floats it</string></property>
        <property name="toolTip"><string>When off, a dragged window snaps back to its tile when you let go. Dropping it on another tile still swaps the two; Meta+F still floats it.</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <item><spacer name="scratchGroupGap"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>0</width><height>14</height></size></property></spacer></item>
   <item>
    <widget class="QLabel" name="scratchGroupHeading">
     <property name="textFormat"><enum>Qt::RichText</enum></property>
     <property name="text"><string>&lt;b&gt;&lt;span style=&quot;font-size:large&quot;&gt;Scratchpad&lt;/span&gt;&lt;/b&gt;</string></property>
     <property name="accessibleName"><string>Scratchpad</string></property>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="scratchGroup">
     <layout class="QFormLayout" name="scratchForm">
      <item row="0" column="0">
       <widget class="QLabel" name="scratchWidthLabel">
        <property name="text"><string>Window &amp;width:</string></property>
        <property name="buddy"><cstring>kcfg_scratchWidth</cstring></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="kcfg_scratchWidth">
        <property name="toolTip"><string>How much of the screen width it gets: 0.6 = 60%, from 0.2 to 1 (full width).</string></property>
        <property name="minimum"><double>0.20</double></property>
        <property name="maximum"><double>1.00</double></property>
        <property name="singleStep"><double>0.05</double></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="scratchHeightLabel">
        <property name="text"><string>Window h&amp;eight:</string></property>
        <property name="buddy"><cstring>kcfg_scratchHeight</cstring></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="kcfg_scratchHeight">
        <property name="toolTip"><string>How much of the screen height it gets: 0.6 = 60%, from 0.2 to 1 (full height).</string></property>
        <property name="minimum"><double>0.20</double></property>
        <property name="maximum"><double>1.00</double></property>
        <property name="singleStep"><double>0.05</double></property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QLabel" name="scratchHint">
        <property name="wordWrap"><bool>true</bool></property>
        <property name="textFormat"><enum>Qt::RichText</enum></property>
        <property name="text"><string>&lt;small&gt;1. Meta+Ctrl+S hides the focused window in the scratchpad.&lt;br&gt;2. Meta+S shows it centred and on top, on whichever desktop you are on. With several windows, each press shows the next one; the press after the last one hides it. It only hides when you press the key.&lt;br&gt;3. Meta+Ctrl+S on a shown window puts it back: tiled, or floating for apps Stacklet doesn&apos;t tile.&lt;br&gt;Hidden windows stay in the taskbar; restoring one from there shows it.&lt;/small&gt;</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <item><spacer name="offGroupGap"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>0</width><height>14</height></size></property></spacer></item>
   <item>
    <widget class="QLabel" name="offGroupHeading">
     <property name="textFormat"><enum>Qt::RichText</enum></property>
     <property name="text"><string>&lt;b&gt;&lt;span style=&quot;font-size:large&quot;&gt;Turn tiling off&lt;/span&gt;&lt;/b&gt;</string></property>
     <property name="accessibleName"><string>Turn tiling off</string></property>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="offGroup">
     <layout class="QFormLayout" name="offForm">
      <item row="0" column="0">
       <widget class="QLabel" name="screensLabel">
        <property name="text"><string>On s&amp;creens:</string></property>
        <property name="buddy"><cstring>kcfg_disabledScreens</cstring></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="kcfg_disabledScreens">
        <property name="placeholderText"><string>e.g. HDMI-A-1</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="desktopsLabel">
        <property name="text"><string>On &amp;desktops:</string></property>
        <property name="buddy"><cstring>kcfg_disabledDesktops</cstring></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="kcfg_disabledDesktops">
        <property name="placeholderText"><string>e.g. 3,4</string></property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QLabel" name="offHint">
        <property name="wordWrap"><bool>true</bool></property>
        <property name="textFormat"><enum>Qt::RichText</enum></property>
        <property name="text"><string>&lt;small&gt;Screens by name (see System Settings → Display), desktops by number. Separate several with commas.&lt;/small&gt;</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <item><spacer name="spacerBehaviour"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Expanding</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>0</height></size></property></spacer></item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabShortcuts">
      <attribute name="title"><string>Shortcuts</string></attribute>
      <layout class="QVBoxLayout" name="tabShortcutsBox">
   <item>
    <widget class="QLabel" name="keysEssentialHeading">
     <property name="textFormat"><enum>Qt::RichText</enum></property>
     <property name="text"><string>&lt;b&gt;&lt;span style=&quot;font-size:large&quot;&gt;Start with these&lt;/span&gt;&lt;/b&gt;</string></property>
     <property name="accessibleName"><string>Start with these</string></property>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="keysEssentialGroup">
     <layout class="QFormLayout" name="keysEssentialForm">
      <property name="labelAlignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property>
      <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Float or re-tile the focused window</string></property></widget></item>
      <item row="0" column="1"><widget class="QLabel"><property name="text"><string>Meta+F</string></property></widget></item>
      <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Tile or untile this app (saved)</string></property></widget></item>
      <item row="1" column="1"><widget class="QLabel"><property name="text"><string>Meta+Alt+A</string></property></widget></item>
      <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Move focus (built into KWin)</string></property></widget></item>
      <item row="2" column="1"><widget class="QLabel"><property name="text"><string>Meta+Alt+arrows</string></property></widget></item>
      <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Swap with the neighbouring window</string></property></widget></item>
      <item row="3" column="1"><widget class="QLabel"><property name="text"><string>Meta+Alt+Shift+arrows</string></property></widget></item>
      <item row="4" column="0"><widget class="QLabel"><property name="text"><string>Switch layout on this screen and desktop</string></property></widget></item>
      <item row="4" column="1"><widget class="QLabel"><property name="text"><string>Meta+Shift+Space</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="keysMoreHeading">
     <property name="textFormat"><enum>Qt::RichText</enum></property>
     <property name="text"><string>&lt;b&gt;&lt;span style=&quot;font-size:large&quot;&gt;More&lt;/span&gt;&lt;/b&gt;</string></property>
     <property name="accessibleName"><string>More</string></property>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="keysGroup">
     <layout class="QFormLayout" name="keysForm">
      <property name="labelAlignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property>
      <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Make the focused window main</string></property></widget></item>
      <item row="0" column="1"><widget class="QLabel"><property name="text"><string>Meta+Shift+Return</string></property></widget></item>
      <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Grow or shrink the main window</string></property></widget></item>
      <item row="1" column="1"><widget class="QLabel"><property name="text"><string>Meta+Alt+] / Meta+Alt+[</string></property></widget></item>
      <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Rotate the stack (add Shift to go back)</string></property></widget></item>
      <item row="2" column="1"><widget class="QLabel"><property name="text"><string>Meta+Alt+T</string></property></widget></item>
      <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Swap two windows with the mouse</string></property></widget></item>
      <item row="3" column="1"><widget class="QLabel"><property name="text"><string>Drag one onto the other</string></property></widget></item>
      <item row="4" column="0"><widget class="QLabel"><property name="text"><string>Monocle on / off (one window fills the screen)</string></property></widget></item>
      <item row="4" column="1"><widget class="QLabel"><property name="text"><string>Meta+Shift+M</string></property></widget></item>
      <item row="5" column="0"><widget class="QLabel"><property name="text"><string>Focus next / previous window (cycles in monocle)</string></property></widget></item>
      <item row="5" column="1"><widget class="QLabel"><property name="text"><string>Meta+Alt+. / Meta+Alt+,</string></property></widget></item>
      <item row="6" column="0"><widget class="QLabel"><property name="text"><string>Spotlight on / off (this window centred, the rest in the stash)</string></property></widget></item>
      <item row="6" column="1"><widget class="QLabel"><property name="text"><string>Meta+Alt+C</string></property></widget></item>
      <item row="7" column="0"><widget class="QLabel"><property name="text"><string>Show the next scratchpad window, or hide it</string></property></widget></item>
      <item row="7" column="1"><widget class="QLabel"><property name="text"><string>Meta+S</string></property></widget></item>
      <item row="8" column="0"><widget class="QLabel"><property name="text"><string>Send to the scratchpad (on a shown one: put it back)</string></property></widget></item>
      <item row="8" column="1"><widget class="QLabel"><property name="text"><string>Meta+Ctrl+S</string></property></widget></item>
      <item row="9" column="0" colspan="2">
       <widget class="QLabel" name="keysHint">
        <property name="wordWrap"><bool>true</bool></property>
        <property name="textFormat"><enum>Qt::RichText</enum></property>
        <property name="text"><string>&lt;small&gt;Change keys in System Settings → Shortcuts → KWin. You can also resize by dragging the border between tiles.&lt;/small&gt;</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <item><spacer name="spacerShortcuts"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Expanding</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>0</height></size></property></spacer></item>
      </layout>
     </widget>
    </widget>
   </item>

   <item>
    <widget class="QLabel" name="applyNote">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>Settings take effect when you close or leave System Settings.</string></property>
    </widget>
   </item>

  </layout>
 </widget>
 <resources/>
 <!-- grey out the app list that the "Tile all apps" box makes unused -->
 <connections>
  <connection><sender>kcfg_tileAll</sender><signal>toggled(bool)</signal><receiver>kcfg_tileClasses</receiver><slot>setDisabled(bool)</slot></connection>
  <connection><sender>kcfg_tileAll</sender><signal>toggled(bool)</signal><receiver>classesLabel</receiver><slot>setDisabled(bool)</slot></connection>
  <connection><sender>kcfg_tileAll</sender><signal>toggled(bool)</signal><receiver>kcfg_floatClasses</receiver><slot>setEnabled(bool)</slot></connection>
  <connection><sender>kcfg_tileAll</sender><signal>toggled(bool)</signal><receiver>kcfg_floatSystem</receiver><slot>setEnabled(bool)</slot></connection>
  <connection><sender>kcfg_tileAll</sender><signal>toggled(bool)</signal><receiver>kcfg_floatMedia</receiver><slot>setEnabled(bool)</slot></connection>
  <connection><sender>kcfg_tileAll</sender><signal>toggled(bool)</signal><receiver>floatClassesLabel</receiver><slot>setEnabled(bool)</slot></connection>
 </connections>
</ui>
